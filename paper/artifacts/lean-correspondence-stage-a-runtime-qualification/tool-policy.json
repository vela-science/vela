{
  "assignment_root": "/stage-a/assignment",
  "authority_effect": "none",
  "filesystem": {
    "assignment_mount": "read_only",
    "cwd": "/stage-a/assignment",
    "hidden_answer_paths": "absent",
    "repository_mutation": "forbidden",
    "root_filesystem": "read_only",
    "scratch": "fresh_bounded_tmpfs_destroyed_at_teardown"
  },
  "network": {
    "participant_tool_network": "none",
    "runner_egress": "exact_selected_provider_endpoint_only",
    "server_hosted_tools": "forbidden"
  },
  "schema": "vela.lean-correspondence-stage-a-read-only-tool-policy.v1",
  "tool_call_ceiling": 128,
  "tools": [
    {
      "arguments": {
        "max_entries": "integer_1_to_4096",
        "path": "assignment_relative_normalized_no_traversal"
      },
      "name": "list_files",
      "result": "lexicographically_sorted_relative_paths"
    },
    {
      "arguments": {
        "byte_limit": "integer_1_to_1048576",
        "byte_offset": "nonnegative_integer",
        "path": "assignment_relative_normalized_regular_file_no_symlink"
      },
      "name": "read_file",
      "result": "exact_bytes_with_offset_length_and_sha256"
    },
    {
      "arguments": {
        "max_matches": "integer_1_to_4096",
        "path": "assignment_relative_normalized_no_traversal",
        "query": "nonempty_literal_utf8"
      },
      "name": "search_text",
      "result": "lexicographically_sorted_path_line_byte_offset_matches"
    },
    {
      "arguments": {
        "argv": "nonempty_array_without_shell_metacharacter_interpretation"
      },
      "name": "run_read_only_shell",
      "result": "stdout_stderr_exit_status_and_truncation_flag"
    }
  ],
  "read_only_shell": {
    "allowed_commands": [
      "cat",
      "find",
      "git cat-file",
      "git diff",
      "git log",
      "git ls-tree",
      "git rev-parse",
      "git show",
      "grep",
      "head",
      "ls",
      "pwd",
      "rg",
      "sed -n",
      "tail"
    ],
    "environment_allowlist": [
      "LANG=C.UTF-8",
      "LC_ALL=C.UTF-8",
      "PATH=/runtime/bin"
    ],
    "executables_byte_bound_in_image": true,
    "process_limit": 16,
    "wall_seconds_per_call": 30
  }
}
