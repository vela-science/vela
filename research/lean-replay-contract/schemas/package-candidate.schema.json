{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app.vela.space/schemas/package-candidate.schema.json",
  "title": "Source-local Vela package candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "package",
    "authority_effect",
    "source",
    "imports",
    "native_dependencies",
    "interfaces",
    "implementation",
    "exports",
    "limitations"
  ],
  "properties": {
    "$schema": { "type": "string", "const": "./schemas/package-candidate.schema.json" },
    "schema": { "type": "string", "const": "vela.package-candidate.v1" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind", "title", "domains", "license"],
      "properties": {
        "id": { "type": "string", "const": "vela-science/lean-replay-contract" },
        "version": { "type": "string", "const": "0.0.0-source-local" },
        "kind": { "type": "string", "const": "replay-contract" },
        "title": { "type": "string", "minLength": 1 },
        "domains": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "authority_effect": { "type": "string", "const": "none" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "exact_revision_location"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "path": { "type": "string", "minLength": 1 },
        "exact_revision_location": { "type": "string", "const": "consumer-reference" }
      }
    },
    "imports": { "type": "array", "maxItems": 0 },
    "native_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ecosystem", "name", "version", "lock_reference"],
        "properties": {
          "ecosystem": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "lock_reference": { "type": "string", "minLength": 1 }
        }
      }
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepts", "emits"],
      "properties": {
        "accepts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "emits": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "network"],
      "properties": {
        "kind": { "type": "string", "const": "python-library" },
        "path": { "type": "string", "const": "lean_replay_contract.py" },
        "network": { "type": "string", "const": "disabled-by-caller-and-checked-platform-policy" }
      }
    },
    "exports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
