  },
  "sampling": {
    "warmups": 1,
    "repetitions": 7,
    "order": "frontier order, then declared operation order",
    "clock": "monotonic wall clock",
    "summary": [
      "minimum_ms",
      "median_ms",
      "maximum_ms"
    ]
  },
  "environment": {
    "empty_home": true,
    "credential_environment_removed": true,
    "network": "denied with the operating-system sandbox when available",
