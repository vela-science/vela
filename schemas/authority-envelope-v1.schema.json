{
  "$id": "https://vela.science/schemas/authority-envelope-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "payload": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9+/_-]+={0,2}$",
      "type": "string"
    },
    "payloadType": {
      "const": "application/vnd.vela.authority-record.v1+json",
      "type": "string"
    },
    "signatures": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "keyid": {
            "type": "string"
          },
          "sig": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9+/_-]+={0,2}$",
            "type": "string"
          }
        },
        "required": [
          "sig"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "payloadType",
    "payload",
    "signatures"
  ],
  "title": "Vela Authority DSSE Envelope v1",
  "type": "object"
}
