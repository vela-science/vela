{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vela.science/schemas/verification-record-v1.schema.json",
  "title": "Vela Verification Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "verification_record_id", "subject", "method", "scope", "outcome", "verifier", "independence", "output_artifact_ids", "started_at", "completed_at", "authentication"],
  "properties": {
    "schema": {"const": "vela.verification-record.v1"},
    "verification_record_id": {"pattern": "^vvr_[0-9a-f]{16}$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "artifact_ids", "submission_id", "submission_root", "proposal_id"],
      "properties": {
        "claim_id": {"pattern": "^vcl_[0-9a-f]{64}$"},
        "artifact_ids": {"type": "array", "items": {"$ref": "#/$defs/artifactId"}},
        "submission_id": {"pattern": "^vsb_.+$"},
        "submission_root": {"$ref": "#/$defs/sha256"},
        "proposal_id": {"pattern": "^vpr_.+$"}
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "implementation", "environment_root"],
      "properties": {
        "profile": {"$ref": "#/$defs/text"},
        "implementation": {"$ref": "#/$defs/text"},
        "environment_root": {"$ref": "#/$defs/sha256"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "does_not_establish"],
      "properties": {
        "property": {"$ref": "#/$defs/text"},
        "does_not_establish": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "outcome": {"enum": ["pass", "fail", "error", "inconclusive"]},
    "verifier": {"$ref": "#/$defs/text"},
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_independent_of", "shared_dependencies"],
      "properties": {
        "declared_independent_of": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "shared_dependencies": {"type": "array", "items": {"$ref": "#/$defs/text"}}
      }
    },
    "output_artifact_ids": {"type": "array", "items": {"$ref": "#/$defs/artifactId"}},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "identity_binding", "signature"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "identity_binding": {"$ref": "#/$defs/identityBinding"},
        "signature": {"$ref": "#/$defs/signature"}
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifactId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
    "identityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "binding_id", "actor_id", "actor_class", "public_key_hex", "created_at", "signature"],
      "properties": {
        "schema": {"const": "vela.identity_binding.v0.1"},
        "binding_id": {"pattern": "^vib_[0-9a-f]{16}$"},
        "actor_id": {"$ref": "#/$defs/text"},
        "actor_class": {"enum": ["human", "agent", "org"]},
        "public_key_hex": {"pattern": "^[0-9a-f]{64}$"},
        "created_at": {"type": "string", "format": "date-time"},
        "signature": {"$ref": "#/$defs/signature"}
      }
    }
  }
}
