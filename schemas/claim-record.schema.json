{
  "$id": "https://vela.science/schemas/claim-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assertion": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "kind"
      ],
      "type": "object"
    },
    "claim_id": {
      "type": "string"
    },
    "conditions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "created_at": {
      "type": "string"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifact_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifact_root": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          }
        },
        "required": [
          "relation",
          "artifact_root"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "extensions": {
      "additionalProperties": true,
      "type": "object"
    },
    "provenance": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "authors": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "kind": {
            "type": "string"
          },
          "locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "year": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "title"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "relations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string"
          },
          "target_claim_id": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "target_claim_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "revision": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "claim_id",
    "revision",
    "assertion",
    "conditions",
    "evidence",
    "provenance",
    "relations",
    "created_at"
  ],
  "title": "Vela Claim Record v1",
  "type": "object"
}
