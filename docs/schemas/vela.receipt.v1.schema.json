{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vela.science/schemas/vela.receipt.v1.schema.json",
  "title": "Vela Receipt v1",
  "description": "Portable in-toto receipt with machine, acceptance, and distillation layers. Receipts carry inheritance evidence. They are not acceptance by themselves.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "claim",
    "type",
    "replayability",
    "artifacts",
    "caveats",
    "verifier_runs",
    "environment",
    "provenance",
    "status",
    "machine",
    "acceptance",
    "distillation",
    "lineage",
    "contributors",
    "signature_identities",
    "attestation"
  ],
  "properties": {
    "schema": {
      "const": "vela.receipt.v1"
    },
    "claim_id": {
      "type": "string"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "computational",
        "theoretical",
        "empirical",
        "negative",
        "contradiction"
      ]
    },
    "replayability": {
      "type": "string",
      "enum": [
        "exact",
        "bounded",
        "approximate",
        "unavailable",
        "unknown"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "caveats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verifier_runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verifier_run"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "verification_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "state_diff": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    },
    "environment": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "vela:execution_binding": {
          "$ref": "#/$defs/execution_binding"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "generated_by",
        "emitted_at"
      ],
      "properties": {
        "generated_by": {
          "type": "string",
          "minLength": 1
        },
        "emitted_at": {
          "type": "string",
          "format": "date-time"
        },
        "submitter": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind",
        "authority"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "draft",
            "emitted",
            "proposed",
            "runs",
            "minimal_sanity_check",
            "reported_metric_rederived",
            "full_reproduction",
            "landed_pending",
            "accepted",
            "rejected",
            "superseded",
            "retracted",
            "contested",
            "failed_reproduction"
          ]
        },
        "authority": {
          "type": "string",
          "enum": [
            "producer",
            "vela_landing",
            "human_key",
            "signed_policy"
          ]
        },
        "evidence_status": {
          "type": "string",
          "enum": [
            "proposed",
            "runs",
            "minimal_sanity_check",
            "reported_metric_rederived",
            "full_reproduction",
            "accepted",
            "superseded",
            "retracted",
            "contested",
            "failed_reproduction"
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "machine": {
      "$ref": "#/$defs/machine_layer"
    },
    "acceptance": {
      "$ref": "#/$defs/acceptance_layer"
    },
    "distillation": {
      "$ref": "#/$defs/distillation_layer"
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    },
    "contributors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/contributor"
      }
    },
    "signature_identities": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "producer"
      ],
      "properties": {
        "producer": {
          "$ref": "#/$defs/signature_identity"
        },
        "acceptor": {
          "$ref": "#/$defs/signature_identity"
        }
      }
    },
    "attestation": {
      "$ref": "#/$defs/attestation"
    }
  },
  "$defs": {
    "execution_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "packet_root",
        "profile_root",
        "verifier_capsule_root",
        "result_contract_root"
      ],
      "properties": {
        "schema": {
          "const": "vela.execution-binding.v1"
        },
        "packet_root": {
          "$ref": "#/$defs/full_sha256_root"
        },
        "profile_root": {
          "$ref": "#/$defs/full_sha256_root"
        },
        "verifier_capsule_root": {
          "$ref": "#/$defs/full_sha256_root"
        },
        "result_contract_root": {
          "$ref": "#/$defs/full_sha256_root"
        }
      }
    },
    "full_sha256_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "path",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        }
      }
    },
    "verifier_run": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "method",
        "outcome"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "error",
            "skipped",
            "unknown"
          ]
        },
        "log": {
          "type": "string"
        },
        "solver": {
          "type": "string"
        },
        "replay_command": {
          "type": "string"
        }
      }
    },
    "acceptance_scope": {
      "type": "string",
      "enum": [
        "machine_verified",
        "human_seen",
        "locally_accepted",
        "frontier_accepted",
        "canon_accepted",
        "hypothesis_only",
        "retracted",
        "superseded"
      ]
    },
    "machine_layer": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "subject",
        "claim",
        "verification"
      ],
      "properties": {
        "subject": {
          "type": "array",
          "minItems": 1
        },
        "claim": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "text",
            "type"
          ]
        },
        "verification": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "status",
            "verifier_runs",
            "trust_base"
          ]
        }
      }
    },
    "acceptance_layer": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "profile",
        "mechanism",
        "acceptor",
        "policyRef",
        "evidenceRefs",
        "artifact_verification",
        "claim_acceptance",
        "distillation_acceptance",
        "acceptance_scope"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "mechanism": {
          "const": "accountable_scientific_steward_signoff"
        },
        "acceptor": {
          "type": [
            "string",
            "null"
          ]
        },
        "policyRef": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceLevel": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "local_signoff",
            "consortium_reviewed",
            "journal_accepted",
            "replicated",
            "regulator_grade",
            null
          ]
        },
        "acceptance_scope": {
          "$ref": "#/$defs/acceptance_scope"
        },
        "artifact_verification": {
          "type": "object",
          "additionalProperties": true
        },
        "claim_acceptance": {
          "type": "object",
          "additionalProperties": true
        },
        "distillation_acceptance": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "distillation_layer": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "audience",
        "rubric"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "missing",
            "not_required",
            "draft",
            "accepted",
            "rejected",
            "superseded",
            "retracted"
          ]
        },
        "uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "digest": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "audience": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "accepted_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "rubric": {
          "type": "string"
        },
        "comprehension_budget": {
          "type": "string"
        },
        "inheritance_note": {
          "type": "string"
        },
        "known_gaps": {
          "type": "array"
        },
        "signature_refs": {
          "type": "array"
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "parents",
        "derived_from",
        "source_refs"
      ]
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "roles"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/contributor_role"
          }
        },
        "credit_taxonomy": {
          "type": "string"
        },
        "author": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "contributor_role": {
      "type": "string",
      "enum": [
        "conceptualization",
        "data_curation",
        "formal_analysis",
        "funding_acquisition",
        "investigation",
        "methodology",
        "project_administration",
        "resources",
        "software",
        "supervision",
        "validation",
        "visualization",
        "writing_original_draft",
        "writing_review_editing",
        "machine_producer",
        "human_formalizer",
        "human_distiller",
        "reviewer",
        "acceptor",
        "profile_maintainer"
      ]
    },
    "signature_identity": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "role",
        "mechanism"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "producer",
            "acceptor"
          ]
        },
        "signatureRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "mechanism": {
          "type": "string",
          "enum": [
            "sigstore_keyless_oidc",
            "sigstore_keyless_oidc_fixture",
            "ed25519_key_custody_ceremony",
            "ed25519_key_custody_ceremony_fixture"
          ]
        },
        "oidcIssuer": {
          "type": "string"
        },
        "orcid": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        }
      }
    },
    "status_event_receipt": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema",
        "target",
        "statusEvent",
        "lineage",
        "provenance",
        "attestation"
      ],
      "properties": {
        "schema": {
          "const": "vela.receipt.statusEvent.v1"
        },
        "statusEvent": {
          "$ref": "#/$defs/status_event"
        }
      }
    },
    "status_event": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "authorityBasis",
        "actor",
        "reasonCode",
        "policyRef",
        "evidenceRefs",
        "createdAt"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "supersedes",
            "withdraws",
            "revokes",
            "challenges",
            "deprecates",
            "restores"
          ]
        },
        "authorityBasis": {
          "type": "string",
          "enum": [
            "original_issuer",
            "acceptor",
            "profile_authority",
            "third_party"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        },
        "policyRef": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replacementReceipt": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "format",
        "statement",
        "dsse_envelope"
      ],
      "properties": {
        "format": {
          "const": "in-toto-statement"
        },
        "statement": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "_type",
            "subject",
            "predicateType",
            "predicate"
          ],
          "properties": {
            "_type": {
              "const": "https://in-toto.io/Statement/v1"
            },
            "subject": {
              "type": "array",
              "minItems": 1
            },
            "predicateType": {
              "const": "https://vela.science/receipt/v1"
            },
            "predicate": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "machine",
                "acceptance",
                "distillation",
                "lineage",
                "provenance"
              ]
            }
          }
        },
        "dsse_envelope": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "payloadType",
            "payload",
            "signatures"
          ],
          "properties": {
            "payloadType": {
              "const": "application/vnd.in-toto+json"
            },
            "payload": {
              "type": "string",
              "minLength": 1
            },
            "signatures": {
              "type": "array"
            }
          }
        }
      }
    }
  }
}
