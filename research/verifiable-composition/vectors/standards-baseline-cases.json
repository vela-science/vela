    {
      "id": "vela-profile-root-substitution",
      "mutation": "profile_manifest_root",
      "expected": "invalid:vela_profile"
    },
    {
      "id": "duplicate-lock-name-refused",
      "mutation": "duplicate_lock_name",
      "expected": "duplicate:lock_object_name"
    }
  ]
