{
  "schema": "vela.experimental-dependency-observation-vectors.v0",
  "base_class": "shape_only_placeholder",
  "base_limit": "The roots and signature are syntactically valid placeholders. Passing the parser does not prove that any Vela or Git object exists or that any authority decision verifies.",
  "base": {
    "schema": "vela.experimental-dependency-observation.v0",
    "parent_frontier_id": "vfr_0123456789abcdef",
    "parent_git_commit": "1111111111111111111111111111111111111111",
    "parent_git_tree": "2222222222222222222222222222222222222222",
    "parent_event_log_root": "sha256:3333333333333333333333333333333333333333333333333333333333333333",
    "parent_snapshot_root": "sha256:4444444444444444444444444444444444444444444444444444444444444444",
    "finding_id": "vf_5555555555555555",
    "finding_revision_root": "sha256:6666666666666666666666666666666666666666666666666666666666666666",
    "decision_event_id": "vev_7777777777777777",
    "decision_event_content_root": "sha256:8888888888888888888888888888888888888888888888888888888888888888",
    "decision_signature": "99999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999",
    "authority_id": "reviewer:fixture",
    "receipt_roots": [
      "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    ],
    "verifier_attachments": [
      {
        "attachment_id": "vva_bbbbbbbbbbbbbbbb",
        "attachment_content_root": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
      }
    ],
    "premise_digest": "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
    "role": "hard"
  },
  "cases": [
    {
      "id": "valid-shape-only",
      "mutation": {
        "kind": "none"
      },
      "expected": "valid"
    },
    {
      "id": "valid-shape-only-current-v1-signature",
      "mutation": {
        "kind": "replace",
        "path": "decision_signature",
        "value": "v1:99999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999"
      },
      "expected": "valid"
    },
    {
      "id": "missing-parent-frontier-id",
      "mutation": {
        "kind": "remove",
        "path": "parent_frontier_id"
      },
      "expected_error": "missing:parent_frontier_id"
    },
    {
      "id": "missing-parent-git-commit",
      "mutation": {
        "kind": "remove",
        "path": "parent_git_commit"
      },
      "expected_error": "missing:parent_git_commit"
    },
    {
      "id": "missing-parent-git-tree",
      "mutation": {
        "kind": "remove",
        "path": "parent_git_tree"
      },
      "expected_error": "missing:parent_git_tree"
    },
    {
      "id": "missing-parent-event-log-root",
      "mutation": {
        "kind": "remove",
        "path": "parent_event_log_root"
      },
      "expected_error": "missing:parent_event_log_root"
    },
    {
      "id": "missing-parent-snapshot-root",
      "mutation": {
        "kind": "remove",
        "path": "parent_snapshot_root"
      },
      "expected_error": "missing:parent_snapshot_root"
    },
    {
      "id": "missing-finding-id",
      "mutation": {
        "kind": "remove",
        "path": "finding_id"
      },
      "expected_error": "missing:finding_id"
    },
    {
      "id": "missing-full-finding-root",
      "mutation": {
        "kind": "remove",
        "path": "finding_revision_root"
      },
      "expected_error": "missing:finding_revision_root"
    },
    {
      "id": "missing-decision-event-id",
      "mutation": {
        "kind": "remove",
        "path": "decision_event_id"
      },
      "expected_error": "missing:decision_event_id"
    },
    {
      "id": "short-handle-only",
      "mutation": {
        "kind": "remove",
        "path": "decision_event_content_root"
      },
      "expected_error": "missing:decision_event_content_root"
    },
    {
      "id": "missing-decision-signature",
      "mutation": {
        "kind": "remove",
        "path": "decision_signature"
      },
      "expected_error": "missing:decision_signature"
    },
    {
      "id": "missing-authority-id",
      "mutation": {
        "kind": "remove",
        "path": "authority_id"
      },
      "expected_error": "missing:authority_id"
    },
    {
      "id": "missing-receipt-roots",
      "mutation": {
        "kind": "remove",
        "path": "receipt_roots"
      },
      "expected_error": "missing:receipt_roots"
    },
    {
      "id": "missing-verifier-attachments",
      "mutation": {
        "kind": "remove",
        "path": "verifier_attachments"
      },
      "expected_error": "missing:verifier_attachments"
    },
    {
      "id": "missing-verifier-attachment-id",
      "mutation": {
        "kind": "remove_attachment_field",
        "path": "attachment_id"
      },
      "expected_error": "invalid:verifier_attachments"
    },
    {
      "id": "missing-verifier-attachment-content-root",
      "mutation": {
        "kind": "remove_attachment_field",
        "path": "attachment_content_root"
      },
      "expected_error": "invalid:verifier_attachments"
    },
    {
      "id": "missing-premise-digest",
      "mutation": {
        "kind": "remove",
        "path": "premise_digest"
      },
      "expected_error": "missing:premise_digest"
    },
    {
      "id": "mismatched-full-root-shape",
      "mutation": {
        "kind": "replace",
        "path": "parent_event_log_root",
        "value": "sha256:deadbeef"
      },
      "expected_error": "invalid:parent_event_log_root"
    },
    {
      "id": "branch-name-instead-of-commit",
      "mutation": {
        "kind": "replace",
        "path": "parent_git_commit",
        "value": "main"
      },
      "expected_error": "invalid:parent_git_commit"
    },
    {
      "id": "mixed-git-object-formats",
      "mutation": {
        "kind": "replace",
        "path": "parent_git_tree",
        "value": "2222222222222222222222222222222222222222222222222222222222222222"
      },
      "expected_error": "invalid:git_object_format"
    },
    {
      "id": "unknown-role",
      "mutation": {
        "kind": "replace",
        "path": "role",
        "value": "automatic_truth"
      },
      "expected_error": "invalid:role"
    },
    {
      "id": "duplicate-receipt-root",
      "mutation": {
        "kind": "append_copy",
        "path": "receipt_roots"
      },
      "expected_error": "duplicate:receipt_roots"
    },
    {
      "id": "too-many-receipt-roots",
      "mutation": {
        "kind": "repeat_list",
        "path": "receipt_roots",
        "count": 257
      },
      "expected_error": "oversized:receipt_roots"
    },
    {
      "id": "duplicate-attachment-id-with-different-root",
      "mutation": {
        "kind": "append_attachment_conflict",
        "path": "verifier_attachments",
        "root": "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
      },
      "expected_error": "duplicate:verifier_attachments"
    },
    {
      "id": "oversized-authority",
      "mutation": {
        "kind": "repeat",
        "path": "authority_id",
        "value": "a",
        "count": 257
      },
      "expected_error": "oversized:authority_id"
    },
    {
      "id": "unexpected-field",
      "mutation": {
        "kind": "add",
        "path": "accepted",
        "value": true
      },
      "expected_error": "unexpected:accepted"
    },
    {
      "id": "duplicate-object-name",
      "raw_json": "{\"schema\":\"vela.experimental-dependency-observation.v0\",\"schema\":\"forged\"}",
      "expected_error": "duplicate:object_name"
    },
    {
      "id": "oversized-document",
      "raw_json_repeat": {
        "prefix": "{\"padding\":\"",
        "unit": "x",
        "count": 1048577,
        "suffix": "\"}"
      },
      "expected_error": "oversized:document"
    }
  ]
}
