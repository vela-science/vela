{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vela.space/experiments/claim-dependency-participant-answer.v0.schema.json",
  "title": "Claim dependency participant answer v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "experiment_id",
    "repository_id",
    "repository_origin_root",
    "transition",
    "classifications",
    "stale_verifications",
    "repair_batches",
    "authority_effect",
    "does_not_establish"
  ],
  "properties": {
    "schema": {
      "const": "vela.claim-dependency-participant-answer.v0"
    },
    "experiment_id": {
      "const": "synthetic-counterfactual-erdos-321-v0"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "repository_origin_root": {
      "$ref": "#/$defs/root"
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "predecessor", "successor"],
      "properties": {
        "kind": {
          "const": "counterfactual_supersession"
        },
        "predecessor": {
          "$ref": "#/$defs/claim_reference"
        },
        "successor": {
          "$ref": "#/$defs/claim_reference"
        }
      }
    },
    "classifications": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/classification"
      }
    },
    "stale_verifications": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/stale_verification"
      }
    },
    "repair_batches": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/repair_batch"
      }
    },
    "authority_effect": {
      "const": "none"
    },
    "does_not_establish": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  },
  "$defs": {
    "root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^vcl_[0-9a-f]{64}$"
    },
    "claim_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "claim_root"],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/claim_id"
        },
        "claim_root": {
          "$ref": "#/$defs/root"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "pointer"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
          "maxLength": 160
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)+$",
          "maxLength": 256
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "claim_id",
        "claim_root",
        "repository_id",
        "repository_origin_root",
        "status",
        "evidence"
      ],
      "properties": {
        "label": {
          "type": "string",
          "pattern": "^[BDE]$"
        },
        "claim_id": {
          "$ref": "#/$defs/claim_id"
        },
        "claim_root": {
          "$ref": "#/$defs/root"
        },
        "repository_id": {
          "type": "string"
        },
        "repository_origin_root": {
          "$ref": "#/$defs/root"
        },
        "status": {
          "enum": ["review_required", "unaffected", "incomplete"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "stale_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_id",
        "verification_root",
        "input_claim_root",
        "claim_label",
        "evidence"
      ],
      "properties": {
        "verification_id": {
          "type": "string",
          "pattern": "^fixture:V_[BDE]$"
        },
        "verification_root": {
          "$ref": "#/$defs/root"
        },
        "input_claim_root": {
          "$ref": "#/$defs/root"
        },
        "claim_label": {
          "type": "string",
          "pattern": "^[BDE]$"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "repair_batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch", "labels"],
      "properties": {
        "batch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "labels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "pattern": "^[BDE]$"
          }
        }
      }
    }
  }
}
