    "excludes": [
      "Git object database bytes",
      "ignored files",
      "untracked files",
      "reinstallable build outputs"
    ]
  },
  "publication": {
    "retain_all_samples": true,
    "retain_normalized_output_roots": true,
    "report_failures": true,
