{
  "$id": "https://vela.science/schemas/proposal-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "caveats": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "created_at": {
      "type": "string"
    },
    "producer_package": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "root": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "root",
        "path"
      ],
      "type": "object"
    },
    "reason": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "root": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "root"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema",
    "action",
    "subject",
    "actor",
    "created_at",
    "reason",
    "producer_package",
    "caveats"
  ],
  "title": "Vela Proposal v1",
  "type": "object"
}
