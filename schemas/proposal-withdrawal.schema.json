{
  "$id": "https://vela.science/schemas/proposal-withdrawal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "proposal_id": {
      "pattern": "^vpr_[0-9a-f]{16}$",
      "type": "string"
    },
    "proposal_root": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "type": "string"
    },
    "schema": {
      "const": "vela.proposal-withdrawal.v2",
      "type": "string"
    },
    "submission_id": {
      "pattern": "^vsb_[0-9a-f]{16}$",
      "type": "string"
    },
    "submission_root": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "proposal_id",
    "proposal_root",
    "submission_id",
    "submission_root",
    "actor",
    "reason",
    "created_at"
  ],
  "title": "Vela Proposal Withdrawal v2",
  "type": "object"
}
