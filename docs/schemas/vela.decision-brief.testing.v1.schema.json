{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vela.science/schemas/vela.decision-brief.testing.v1.schema.json",
  "title": "Vela Decision Brief testing v1",
  "description": "A deterministic, read-only projection of facts needed to review one pending proposal. A Decision Brief is presentation input, not a verdict, signature preimage, trust claim, or source of scientific authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "stability",
    "change",
    "basis",
    "impact",
    "authority",
    "audit",
    "missing",
    "facets"
  ],
  "properties": {
    "schema": {
      "const": "vela.decision-brief.testing.v1"
    },
    "stability": {
      "const": "testing"
    },
    "change": {
      "$ref": "#/$defs/change"
    },
    "basis": {
      "$ref": "#/$defs/basis"
    },
    "impact": {
      "$ref": "#/$defs/impact"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "audit": {
      "$ref": "#/$defs/audit"
    },
    "missing": {
      "description": "Decision-critical unknowns remain separate from known fact roots. The rendered list is bounded; audit.missing_root binds the complete list.",
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/missing_fact"
      }
    },
    "facets": {
      "description": "An extensible, sorted map of typed and independently root-bound projections. Facets do not confer authority.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/typed_facet"
      }
    }
  },
  "$defs": {
    "root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullable_root": {
      "oneOf": [
        {
          "$ref": "#/$defs/root"
        },
        {
          "type": "null"
        }
      ]
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "fixed_base",
        "claim",
        "before",
        "after",
        "requested_action"
      ],
      "properties": {
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "fixed_base": {
          "$ref": "#/$defs/fixed_base"
        },
        "claim": {
          "type": "string",
          "maxLength": 4097
        },
        "before": {
          "$ref": "#/$defs/nullable_claim_state"
        },
        "after": {
          "$ref": "#/$defs/nullable_claim_state"
        },
        "requested_action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fixed_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_log_root",
        "receipt_event_log_root"
      ],
      "properties": {
        "event_log_root": {
          "$ref": "#/$defs/root"
        },
        "receipt_event_log_root": {
          "$ref": "#/$defs/nullable_root"
        }
      }
    },
    "nullable_claim_state": {
      "oneOf": [
        {
          "$ref": "#/$defs/claim_state"
        },
        {
          "type": "null"
        }
      ]
    },
    "claim_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "maxLength": 4097
        }
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_evidence_roots",
        "check_state",
        "main_caveat",
        "attributed_interpretation"
      ],
      "properties": {
        "primary_evidence_roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_root"
          }
        },
        "check_state": {
          "$ref": "#/$defs/check_state"
        },
        "main_caveat": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 2049
            },
            {
              "type": "null"
            }
          ]
        },
        "attributed_interpretation": {
          "oneOf": [
            {
              "$ref": "#/$defs/attributed_interpretation"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evidence_root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "root"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "$ref": "#/$defs/root"
        }
      }
    },
    "check_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_status",
        "gate_reasons",
        "durable_verifier_count",
        "durable_verifier_snapshot_root",
        "engine_status",
        "engine_new_blocking",
        "engine_new_warnings",
        "producer_reported"
      ],
      "properties": {
        "gate_status": {
          "type": "string",
          "enum": [
            "needs_verification",
            "verified",
            "refuted"
          ]
        },
        "gate_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "durable_verifier_count": {
          "type": "integer",
          "minimum": 0
        },
        "durable_verifier_snapshot_root": {
          "$ref": "#/$defs/root"
        },
        "engine_status": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "pass",
                "warn",
                "blocked"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "engine_new_blocking": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "engine_new_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "producer_reported": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/producer_reported_check"
          }
        }
      }
    },
    "producer_reported_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "outcome",
        "authority"
      ],
      "properties": {
        "method": {
          "type": "string",
          "maxLength": 513
        },
        "outcome": {
          "type": "string",
          "maxLength": 513
        },
        "authority": {
          "const": "producer"
        }
      }
    },
    "attributed_interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "authority",
        "text"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "maxLength": 513
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "maxLength": 4097
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "downstream_effect",
        "correction_path",
        "critical_warnings"
      ],
      "properties": {
        "downstream_effect": {
          "$ref": "#/$defs/downstream_effect"
        },
        "correction_path": {
          "$ref": "#/$defs/correction_path"
        },
        "critical_warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/critical_warning"
          }
        }
      }
    },
    "downstream_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed_findings",
        "downstream_dependents",
        "impact_tier"
      ],
      "properties": {
        "changed_findings": {
          "type": "integer",
          "minimum": 0
        },
        "downstream_dependents": {
          "type": "integer",
          "minimum": 0
        },
        "impact_tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "correction_path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "while_pending",
        "after_acceptance"
      ],
      "properties": {
        "while_pending": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "after_acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "critical_warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "reference"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frontier",
        "route",
        "scope",
        "why_human",
        "actions"
      ],
      "properties": {
        "frontier": {
          "$ref": "#/$defs/frontier_reference"
        },
        "route": {
          "type": "string",
          "enum": [
            "defer",
            "deny",
            "broken",
            "permit_pending"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "why_human": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2049
          }
        },
        "actions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/action"
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "const": "accept"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "const": "reject"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        }
      }
    },
    "frontier_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "eligibility",
        "reasons"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "accept",
            "reject"
          ]
        },
        "eligibility": {
          "type": "string",
          "enum": [
            "available",
            "blocked"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "reject"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "eligibility": {
                "const": "available"
              },
              "reasons": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eligibility": {
                "const": "available"
              }
            },
            "required": [
              "eligibility"
            ]
          },
          "then": {
            "properties": {
              "reasons": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "reasons": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "proposal_id",
        "proposal_root",
        "decision_facts_root",
        "receipt_root",
        "declared_receipt_root",
        "artifact_root",
        "policy_input_root",
        "policy_result_root",
        "publication_root",
        "raw_references_root",
        "raw_references",
        "raw_references_truncated",
        "missing_root",
        "missing_truncated",
        "truncations"
      ],
      "properties": {
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "proposal_id": {
          "type": "string",
          "minLength": 1
        },
        "proposal_root": {
          "$ref": "#/$defs/root"
        },
        "decision_facts_root": {
          "description": "Testing-stage drift detector over known fact roots and the complete typed missing-fact set. It is not a verdict or authority root.",
          "$ref": "#/$defs/root"
        },
        "receipt_root": {
          "$ref": "#/$defs/nullable_root"
        },
        "declared_receipt_root": {
          "$ref": "#/$defs/nullable_root"
        },
        "artifact_root": {
          "$ref": "#/$defs/nullable_root"
        },
        "policy_input_root": {
          "$ref": "#/$defs/root"
        },
        "policy_result_root": {
          "$ref": "#/$defs/root"
        },
        "publication_root": {
          "$ref": "#/$defs/nullable_root"
        },
        "raw_references_root": {
          "description": "Root of the complete sorted and deduplicated reference list before rendering bounds are applied.",
          "$ref": "#/$defs/root"
        },
        "raw_references": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 513
          }
        },
        "raw_references_truncated": {
          "type": "integer",
          "minimum": 0
        },
        "missing_root": {
          "description": "Root of the complete sorted and deduplicated typed missing-fact list before the 16-item rendering bound.",
          "$ref": "#/$defs/root"
        },
        "missing_truncated": {
          "type": "integer",
          "minimum": 0
        },
        "truncations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/truncation"
          }
        }
      }
    },
    "truncation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "full_root",
        "omitted_bytes"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "full_root": {
          "$ref": "#/$defs/root"
        },
        "omitted_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "missing_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "reason"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "typed_facet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "critical",
        "full_root",
        "truncated",
        "data"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^vela\\.decision-brief\\.facet\\.[a-z0-9-]+\\.testing\\.v1$"
        },
        "critical": {
          "type": "boolean"
        },
        "full_root": {
          "description": "Root of the complete selected source value before facet rendering bounds are applied.",
          "$ref": "#/$defs/root"
        },
        "truncated": {
          "type": "boolean"
        },
        "data": {
          "$ref": "#/$defs/bounded_value"
        }
      }
    },
    "bounded_value": {
      "description": "A bounded display projection. Generic signed or trusted properties are forbidden because authority must remain typed and attributed.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 1025
        },
        {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/bounded_value"
          }
        },
        {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "not": {
              "enum": [
                "signed",
                "trusted"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/bounded_value"
          }
        }
      ]
    }
  }
}
