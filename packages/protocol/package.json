{
  "name": "@vela-science/protocol",
  "version": "0.1.1",
  "description": "Public Vela protocol types, canonical encoding, roots, and validators",
  "type": "module",
  "private": false,
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vela-science/vela.git",
    "directory": "packages/protocol"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22 <23 || >=24 <25"
  },
  "packageManager": "bun@1.3.12",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/canonical.d.ts",
    "dist/canonical.js",
    "dist/current.d.ts",
    "dist/current.js",
    "dist/index.d.ts",
    "dist/index.js",
    "dist/validation.d.ts",
    "dist/validation.js",
    "dist/verify.d.ts",
    "dist/verify.js",
    "README.md",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && node --test 'dist/**/*.test.js'",
    "prepack": "bun run build",
    "pack:check": "bun pm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
