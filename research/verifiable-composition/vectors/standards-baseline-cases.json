      "mutation": "statement_subject_root",
      "expected": "mismatch:statement_subject_digest"
    },
    {
      "id": "statement-authority-claim-refused",
      "mutation": "statement_representation_claim",
      "expected": "invalid:representation_claim"
    },
    {
      "id": "dsse-payload-substitution",
      "mutation": "dsse_payload",
      "expected": "mismatch:dsse_payload"
    },
    {
      "id": "scientific-dsse-signature-injection",
      "mutation": "dsse_signature_injection",
      "expected": "invalid:dsse_signatures"
    },
    {
      "id": "lock-payload-substitution",
      "mutation": "lock_fact_root",
      "expected": "invalid:science.lock.fixture_signature"
    },
    {
      "id": "lock-signature-substitution",
      "mutation": "lock_signature",
      "expected": "invalid:science.lock.fixture_signature"
    },
    {
      "id": "lock-public-key-substitution",
      "mutation": "lock_public_key",
