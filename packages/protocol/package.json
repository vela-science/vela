{
  "name": "@vela-science/protocol",
  "version": "0.2.0",
  "description": "Internal Vela protocol types, canonical encoding, roots, and validators",
  "type": "module",
  "private": true,
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vela-science/vela.git",
    "directory": "packages/protocol"
  },
  "engines": {
    "node": ">=22 <23 || >=24 <25"
  },
  "packageManager": "bun@1.3.12",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && node --test 'dist/**/*.test.js'"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
