{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app.vela.space/schemas/lean-replay-request.v1.schema.json",
  "title": "Exact Lean replay request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authority_effect", "source", "environment", "declaration", "candidate", "limits"],
  "properties": {
    "schema": { "type": "string", "const": "vela.lean-replay-request.v1" },
    "authority_effect": { "type": "string", "const": "none" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree", "path", "sha256"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/root" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lean_toolchain", "mathlib_revision", "network"],
      "properties": {
        "lean_toolchain": { "type": "string", "minLength": 1 },
        "mathlib_revision": { "type": "string", "minLength": 1 },
        "network": { "type": "string", "const": "denied" },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "declaration": { "type": "string", "minLength": 1 },
    "candidate": { "type": "object" },
    "limits": { "type": "object" }
  },
  "$defs": {
    "root": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}

