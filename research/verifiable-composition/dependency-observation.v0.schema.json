{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vela.science/schemas/experimental/dependency-observation.v0.schema.json",
  "title": "Experimental Vela dependency observation v0",
  "description": "Experiment-only full-root dependency input. It is producer provenance, not accepted state or a public Vela wire object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "parent_frontier_id",
    "parent_git_commit",
    "parent_git_tree",
    "parent_event_log_root",
    "parent_snapshot_root",
    "finding_id",
    "finding_revision_root",
    "decision_event_id",
    "decision_event_content_root",
    "decision_signature",
    "authority_id",
    "receipt_roots",
    "verifier_attachments",
    "premise_digest",
    "role"
  ],
  "oneOf": [
    {
      "title": "SHA-1-format Git object identifiers",
      "properties": {
        "parent_git_commit": { "$ref": "#/$defs/gitOid40" },
        "parent_git_tree": { "$ref": "#/$defs/gitOid40" }
      }
    },
    {
      "title": "SHA-256-format Git object identifiers",
      "properties": {
        "parent_git_commit": { "$ref": "#/$defs/gitOid64" },
        "parent_git_tree": { "$ref": "#/$defs/gitOid64" }
      }
    }
  ],
  "properties": {
    "schema": {
      "const": "vela.experimental-dependency-observation.v0"
    },
    "parent_frontier_id": {
      "type": "string",
      "pattern": "^vfr_[0-9a-f]{16}$"
    },
    "parent_git_commit": {
      "description": "Full Git commit object ID; its object format must match parent_git_tree.",
      "oneOf": [
        { "$ref": "#/$defs/gitOid40" },
        { "$ref": "#/$defs/gitOid64" }
      ]
    },
    "parent_git_tree": {
      "description": "Full Git tree object ID; its object format must match parent_git_commit.",
      "oneOf": [
        { "$ref": "#/$defs/gitOid40" },
        { "$ref": "#/$defs/gitOid64" }
      ]
    },
    "parent_event_log_root": {
      "$ref": "#/$defs/sha256"
    },
    "parent_snapshot_root": {
      "$ref": "#/$defs/sha256"
    },
    "finding_id": {
      "type": "string",
      "pattern": "^vf_[0-9a-f]{16}$"
    },
    "finding_revision_root": {
      "$ref": "#/$defs/sha256"
    },
    "decision_event_id": {
      "type": "string",
      "pattern": "^vev_[0-9a-f]{16}$"
    },
    "decision_event_content_root": {
      "$ref": "#/$defs/sha256"
    },
    "decision_signature": {
      "type": "string",
      "pattern": "^(v1:)?[0-9a-f]{128}$"
    },
    "authority_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+~-]*$"
    },
    "receipt_roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "verifier_attachments": {
      "type": "array",
      "description": "Attachment IDs MUST be unique even when their content roots differ; the reference validator enforces this semantic constraint.",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attachment_id",
          "attachment_content_root"
        ],
        "properties": {
          "attachment_id": {
            "type": "string",
            "pattern": "^vva_[0-9a-f]{16}$"
          },
          "attachment_content_root": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "premise_digest": {
      "$ref": "#/$defs/sha256"
    },
    "role": {
      "enum": [
        "hard",
        "soft",
        "data",
        "method",
        "contextual"
      ]
    }
  },
  "$defs": {
    "gitOid40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gitOid64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
