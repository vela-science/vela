{
  "$id": "https://vela.science/schemas/repository-origin-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "generation": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "initial_object_set_root": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "genesis",
        "compaction"
      ],
      "type": "string"
    },
    "origin_id": {
      "type": "string"
    },
    "predecessor": {
      "additionalProperties": false,
      "properties": {
        "archive_sha256": {
          "type": "string"
        },
        "archived_actor_registry_root": {
          "type": "string"
        },
        "archived_event_log_root": {
          "type": "string"
        },
        "authority_head_root": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "equivalence_report_root": {
          "type": "string"
        },
        "object_manifest_root": {
          "type": "string"
        },
        "remote": {
          "type": "string"
        },
        "repository_root": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "tree": {
          "type": "string"
        }
      },
      "required": [
        "remote",
        "tag",
        "commit",
        "tree",
        "repository_root",
        "authority_head_root",
        "archived_event_log_root",
        "archived_actor_registry_root",
        "archive_sha256",
        "object_manifest_root",
        "equivalence_report_root"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "profile_root": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "repository_id": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "origin_id",
    "repository_id",
    "generation",
    "profile_root",
    "initial_object_set_root",
    "kind",
    "reason"
  ],
  "title": "Vela Repository Origin v1",
  "type": "object"
}
