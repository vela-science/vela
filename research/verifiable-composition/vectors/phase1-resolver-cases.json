{
  "schema": "vela.experimental-dependency-resolver-vectors.v0",
  "note": "The test constructs two real local Git commits and replaces these fields with shape-valid but byte-wrong values. The wrong full commit has a different tree and must fail the original tree binding.",
  "cases": [
    {
      "id": "branch-name-refused",
      "operation": "commit_input",
      "value": "main",
      "expected_code": "invalid:parent_git_commit"
    },
    {
      "id": "short-commit-refused",
      "operation": "commit_input",
      "value": "1234abcd",
      "expected_code": "invalid:parent_git_commit"
    },
    {
      "id": "shape-valid-wrong-full-commit-refused",
      "operation": "observation_commit",
      "expected_code": "mismatch:parent_git_tree"
    },
    {
      "id": "symlink-premise-refused",
      "operation": "selection_premise",
      "value": "inputs/symlink-premise.json",
      "expected_code": "git:non_regular_entry"
    },
    {
      "id": "exact-tree-byte-mismatch",
      "operation": "observation_root",
      "field": "parent_git_tree",
      "expected_code": "mismatch:parent_git_tree"
    },
    {
      "id": "frontier-id-byte-mismatch",
      "operation": "observation_identifier",
      "field": "parent_frontier_id",
      "expected_code": "mismatch:parent_frontier_id"
    },
    {
      "id": "event-log-byte-mismatch",
      "operation": "observation_root",
      "field": "parent_event_log_root",
      "expected_code": "mismatch:parent_event_log_root"
    },
    {
      "id": "snapshot-byte-mismatch",
      "operation": "observation_root",
      "field": "parent_snapshot_root",
      "expected_code": "mismatch:parent_snapshot_root"
    },
    {
      "id": "finding-revision-byte-mismatch",
      "operation": "observation_root",
      "field": "finding_revision_root",
      "expected_code": "mismatch:finding_revision_root"
    },
    {
      "id": "decision-content-byte-mismatch",
      "operation": "observation_root",
      "field": "decision_event_content_root",
      "expected_code": "mismatch:decision_event_content_root"
    },
    {
      "id": "signature-byte-mismatch",
      "operation": "observation_signature",
      "field": "decision_signature",
      "expected_code": "mismatch:decision_signature_bytes"
    },
    {
      "id": "authority-byte-mismatch",
      "operation": "observation_authority",
      "field": "authority_id",
      "expected_code": "mismatch:authority_actor_id"
    },
    {
      "id": "receipt-byte-mismatch",
      "operation": "receipt_root",
      "expected_code": "mismatch:receipt_roots"
    },
    {
      "id": "attachment-byte-mismatch",
      "operation": "attachment_root",
      "expected_code": "mismatch:verifier_attachment_roots"
    },
    {
      "id": "premise-byte-mismatch",
      "operation": "observation_root",
      "field": "premise_digest",
      "expected_code": "mismatch:premise_digest"
    }
  ]
}
