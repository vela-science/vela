{
  "name": "@vela-science/agent-internal",
  "version": "0.0.0",
  "description": "Private implementation candidate for Vela's removable Agent executor",
  "type": "module",
  "private": true,
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vela-science/vela.git",
    "directory": "packages/canopus"
  },
  "engines": {
    "node": ">=22 <23 || >=24 <25"
  },
  "packageManager": "bun@1.3.12",
  "scripts": {
    "build": "node tooling/clean-dist.mjs && tsc -p tsconfig.json && bun tooling/build-agent-helper.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && node --test 'dist/tests/**/*.test.js' 'tests/**/*.test.mjs'",
    "check": "bun run lint && bun run test",
    "fixture:hostile-custody": "node tests/fixtures/run-hostile-native-custody.mjs",
    "fixture:hostile-verifier": "node tests/fixtures/run-hostile-verifier.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@vela-science/protocol": "workspace:*"
  }
}
