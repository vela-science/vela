    "second_prelaunch_first_twelve_layers_matched": true,
    "second_prelaunch_only_differing_file": "/etc/shadow",
    "second_prelaunch_only_differing_byte_offset": 519,
    "reviewed_participant_shadow_entry": "participant:!:20686:0:99999:7:::",
    "fresh_participant_shadow_entry": "participant:!:20687:0:99999:7:::",
    "causes": [
      "Build-time timestamps were retained in image config and custom layer tar headers.",
      "npm and Node compile caches retained time-dependent build-only bytes.",
      "useradd wrote the current UTC day into the participant last-password-change field in /etc/shadow; OCI timestamp rewriting cannot normalize file content.",
      "The trust-source stage fetched Debian repository metadata and signatures during each build, so a pinned package digest did not eliminate repository, clock, signature, or network availability dependencies.",
      "The account normalizer validated the fixed replacement day but did not require the existing participant last-password-change field to be numeric before replacement."
    ]
  },
