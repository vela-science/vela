{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standing",
    "correction",
    "affected_declarations",
    "verifications",
    "decision",
    "benchmark_null_reason",
    "next_target",
    "nonclaims"
  ],
  "properties": {
    "standing": { "type": "string" },
    "correction": { "type": "string" },
    "affected_declarations": { "type": "array", "items": { "type": "string" } },
    "verifications": { "type": "array", "items": { "type": "string" } },
    "decision": { "type": "string" },
    "benchmark_null_reason": { "type": "string" },
    "next_target": { "type": "string" },
    "nonclaims": { "type": "array", "items": { "type": "string" } }
  }
}
