{
  "endpoint": "https://api.anthropic.com/v1/messages",
  "events": {
    "raw_bytes_retained_before_normalization": true,
    "terminal_and_teardown_receipts_required": true,
    "tool_arguments_retained": true,
    "tool_results_retained": true,
    "usage_retained_as_telemetry_only": true
  },
  "provider_adapter": "anthropic-messages-v1",
  "request": {
    "anthropic_version": "2023-06-01",
    "api": "Messages",
    "max_tokens": 32768,
    "output_config_effort": "high",
    "service_tier": "standard_only",
    "temperature": "omitted",
    "thinking": "adaptive"
  },
  "schema": "vela.stage-a-provider-runtime-contract.v1",
  "tools": [
    {
      "allowed_argv": [
        "git",
        "--no-optional-locks",
        "status",
        "--short"
      ],
      "cwd": "/workspace",
      "name": "shell",
      "read_only": true,
      "shell_interpolation": false
    },
    {
      "name": "read_file",
      "operations": [
        "read",
        "list",
        "stat"
      ],
      "path_escape": false,
      "regular_files_only": true,
      "symlinks": false,
      "workspace": "/workspace",
      "write": false
    }
  ],
  "transport": {
    "credential_fd": 4,
    "credential_retained": false,
    "host_bridge_fd": 3,
    "host_bridge_single_endpoint": "https://api.anthropic.com/v1/messages",
    "participant_network": false,
    "proxy_environment": "ignored",
    "redirects": "rejected",
    "unrestricted_clients": false
  }
}
