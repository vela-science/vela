{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vela.science/schemas/authority-envelope-v1.schema.json",
  "title": "Vela Authority DSSE Envelope v1",
  "type": "object",
  "required": ["payloadType", "payload", "signatures"],
  "properties": {
    "payloadType": {"const": "application/vnd.vela.authority-record.v1+json"},
    "payload": {"$ref": "#/$defs/base64"},
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sig"],
        "properties": {
          "keyid": {"type": "string"},
          "sig": {"$ref": "#/$defs/base64"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "base64": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9+/_-]+={0,2}$"}
  }
}
