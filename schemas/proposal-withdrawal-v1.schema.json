{
  "$id": "https://vela.science/schemas/proposal-withdrawal-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "type": "string"
    },
    "authentication": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ed25519",
          "type": "string"
        },
        "signature": {
          "pattern": "^[0-9a-f]{128}$",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "signature"
      ],
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "proposal_id": {
      "pattern": "^vpr_.+$",
      "type": "string"
    },
    "proposal_root": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "type": "string"
    },
    "schema": {
      "const": "vela.proposal-withdrawal.v1",
      "type": "string"
    },
    "submission_id": {
      "pattern": "^vsb_.+$",
      "type": "string"
    },
    "submission_root": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "withdrawal_id": {
      "pattern": "^vpw_.+$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "withdrawal_id",
    "proposal_id",
    "proposal_root",
    "submission_id",
    "submission_root",
    "actor",
    "reason",
    "created_at",
    "authentication"
  ],
  "title": "Vela Proposal Withdrawal v1",
  "type": "object"
}
