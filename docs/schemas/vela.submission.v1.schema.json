{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vela.science/schemas/vela.submission.v1.schema.json",
  "title": "Vela Submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "submission_id",
    "claim",
    "artifacts",
    "caveats",
    "replayability",
    "producer_checks",
    "verification_requirements",
    "requested_change",
    "provenance",
    "authentication"
  ],
  "properties": {
    "schema": { "const": "vela.submission.v1" },
    "submission_id": { "type": "string", "pattern": "^vsb_[0-9a-f]{16}$" },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion", "type", "conditions"],
      "properties": {
        "assertion": { "$ref": "#/$defs/nonempty" },
        "type": {
          "enum": ["computational", "theoretical", "empirical", "negative", "contradiction"]
        },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonempty" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "digest"],
        "properties": {
          "kind": { "$ref": "#/$defs/nonempty" },
          "path": { "$ref": "#/$defs/nonempty" },
          "digest": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "caveats": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonempty" }
    },
    "replayability": {
      "enum": ["exact", "bounded", "approximate", "unavailable", "unknown"]
    },
    "producer_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "outcome", "authority"],
        "properties": {
          "method": { "$ref": "#/$defs/nonempty" },
          "outcome": { "enum": ["pass", "fail", "error", "skipped", "unknown"] },
          "authority": { "const": "producer_reported" }
        }
      }
    },
    "verification_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonempty" }
    },
    "requested_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["add_claim", "correct_claim", "supersede_claim", "retract_claim"] },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim_id", "claim_root"],
          "properties": {
            "claim_id": { "type": "string", "pattern": "^vf_[0-9a-f]{16}$" },
            "claim_root": { "$ref": "#/$defs/sha256" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "add_claim" } },
            "required": ["kind"]
          },
          "then": { "not": { "required": ["target"] } },
          "else": { "required": ["target"] }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "source_system", "emitted_at"],
      "properties": {
        "producer": { "type": "string", "pattern": "^(agent|ci):.+" },
        "source_system": { "$ref": "#/$defs/nonempty" },
        "source_run": { "$ref": "#/$defs/nonempty" },
        "emitted_at": { "type": "string", "format": "date-time" }
      }
    },
    "execution_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "packet_root",
        "profile_root",
        "verifier_capsule_root",
        "result_contract_root"
      ],
      "properties": {
        "schema": { "const": "vela.execution-binding.v1" },
        "packet_root": { "$ref": "#/$defs/sha256" },
        "profile_root": { "$ref": "#/$defs/sha256" },
        "verifier_capsule_root": { "$ref": "#/$defs/sha256" },
        "result_contract_root": { "$ref": "#/$defs/sha256" }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "identity_binding", "signature"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "identity_binding": { "type": "object" },
        "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      }
    }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
