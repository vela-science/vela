{
  "$id": "https://vela.science/schemas/status.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "actions": {
      "properties": {
        "review": {
          "anyOf": [
            {
              "properties": {
                "command": {
                  "maxLength": 16384,
                  "minLength": 1,
                  "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
                  "type": "string"
                },
                "pending_count": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "pending_count",
                "command"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "work": {
          "oneOf": [
            {
              "properties": {
                "command": {
                  "maxLength": 16384,
                  "minLength": 1,
                  "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
                  "type": "string"
                },
                "mode": {
                  "const": "direct_submission",
                  "type": "string"
                },
                "note": {
                  "maxLength": 16384,
                  "minLength": 1,
                  "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
                  "type": "string"
                }
              },
              "required": [
                "mode",
                "command",
                "note"
              ],
              "type": "object"
            },
            {
              "properties": {
                "command": {
                  "maxLength": 16384,
                  "minLength": 1,
                  "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
                  "type": "string"
                },
                "mode": {
                  "const": "authority_uninitialized",
                  "type": "string"
                },
                "note": {
                  "maxLength": 16384,
                  "minLength": 1,
                  "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
                  "type": "string"
                }
              },
              "required": [
                "mode",
                "command",
                "note"
              ],
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "review",
        "work"
      ],
      "type": "object"
    },
    "command": {
      "const": "status",
      "type": "string"
    },
    "counts": {
      "properties": {
        "accepted_claims": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "accepted_review": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "artifacts": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "claims": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "pending_claims": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "pending_review": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rejected_review": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "submissions": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "verifications": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "withdrawn_review": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "claims",
        "accepted_claims",
        "pending_claims",
        "pending_review",
        "accepted_review",
        "rejected_review",
        "withdrawn_review",
        "submissions",
        "verifications",
        "artifacts"
      ],
      "type": "object"
    },
    "decision_inbox": {
      "properties": {
        "first_entry_root": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "pending_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "projection_root": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "protocol_blocked_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "protocol_ready_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "pending_count",
        "protocol_ready_count",
        "protocol_blocked_count",
        "projection_root",
        "first_entry_root"
      ],
      "type": "object"
    },
    "git": {
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "const": "repository_head",
          "type": "string"
        },
        "tree": {
          "pattern": "^[0-9a-f]{40}$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "role",
        "commit",
        "tree"
      ],
      "type": "object"
    },
    "integrity": {
      "properties": {
        "blocker_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "blockers_by_code": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        },
        "replay": {
          "enum": [
            "verified",
            "not_initialized"
          ],
          "type": "string"
        },
        "strict": {
          "enum": [
            "pass",
            "blocked"
          ],
          "type": "string"
        }
      },
      "required": [
        "replay",
        "strict",
        "blocker_count",
        "blockers_by_code"
      ],
      "type": "object"
    },
    "ok": {
      "const": true,
      "type": "boolean"
    },
    "repository": {
      "properties": {
        "id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "name": {
          "maxLength": 16384,
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "profile_root": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "profile_root"
      ],
      "type": "object"
    },
    "roots": {
      "properties": {
        "authority_keyset": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "authority_policy": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "repository": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "origin",
        "repository",
        "authority_keyset",
        "authority_policy"
      ],
      "type": "object"
    },
    "schema": {
      "const": "vela.status.v4",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "ok",
    "command",
    "repository",
    "git",
    "integrity",
    "roots",
    "counts",
    "decision_inbox",
    "actions"
  ],
  "title": "Vela Status v4",
  "type": "object"
}
