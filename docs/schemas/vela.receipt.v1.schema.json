{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellate.science/schemas/vela.receipt.v1.schema.json",
  "title": "Vela Receipt v1",
  "description": "Portable activity packet emitted by external producers before Vela landing. Receipts are evidence, not verdicts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim",
    "type",
    "replayability",
    "artifacts",
    "caveats",
    "verifier_runs",
    "environment",
    "provenance",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "vela.receipt.v1"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "computational",
        "theoretical",
        "empirical",
        "negative",
        "contradiction"
      ]
    },
    "replayability": {
      "type": "string",
      "enum": [
        "exact",
        "bounded",
        "approximate",
        "unavailable",
        "unknown"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "caveats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verifier_runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verifier_run"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "verification_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "state_diff": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    },
    "environment": {
      "type": "object",
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "generated_by",
        "emitted_at"
      ],
      "properties": {
        "generated_by": {
          "type": "string",
          "minLength": 1
        },
        "submitter": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "actor": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "uri": {
              "type": "string"
            }
          }
        },
        "emitted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "authority"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "draft",
            "emitted",
            "landed_pending",
            "accepted",
            "rejected",
            "superseded"
          ]
        },
        "authority": {
          "type": "string",
          "enum": [
            "producer",
            "vela_landing",
            "human_key",
            "signed_policy"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "path",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        }
      }
    },
    "verifier_run": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "method",
        "outcome"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "error",
            "skipped",
            "unknown"
          ]
        },
        "log": {
          "type": "string"
        },
        "solver": {
          "type": "string"
        },
        "replay_command": {
          "type": "string"
        }
      }
    }
  }
}
