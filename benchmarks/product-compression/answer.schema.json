{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "frontier", "next_work", "decision"],
  "properties": {
    "schema": {"const": "vela.product-compression-answer.v7"},
    "frontier": {"$ref": "#/$defs/frontier"},
    "next_work": {"$ref": "#/$defs/nextWork"},
    "decision": {"$ref": "#/$defs/decision"}
  },
  "$defs": {
    "root": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "frontier": {
      "type": "object", "additionalProperties": false,
      "required": ["frontier_id", "repository_root"],
      "properties": {
        "frontier_id": {"type": "string", "pattern": "^vfr_[0-9a-f]{16}$"},
        "repository_root": {"$ref": "#/$defs/root"}
      }
    },
    "nextWork": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "target_index_root", "packet_sha256", "next_command"],
      "properties": {
        "target_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
        "target_index_root": {"$ref": "#/$defs/root"},
        "packet_sha256": {"$ref": "#/$defs/root"},
        "next_command": {"type": "string", "pattern": "^vela start [A-Za-z0-9._:-]+ --frontier /workspace/frontier --json$"}
      }
    },
    "standing": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "claim_root"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^vcl_[0-9a-f]{64}$"},
        "claim_root": {"$ref": "#/$defs/root"}
      }
    },
    "standingState": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_root", "accepted"],
      "properties": {
        "repository_root": {"$ref": "#/$defs/root"},
        "accepted": {"type": "array", "items": {"$ref": "#/$defs/standing"}}
      }
    },
    "standingDelta": {
      "type": "object", "additionalProperties": false,
      "required": ["transition", "scope", "before", "if_accept", "if_reject"],
      "properties": {
        "transition": {"const": "add accepted Claim"},
        "scope": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "target_claim_id", "affected_claim_ids"],
          "properties": {
            "kind": {"const": "proposal_affected_claims"},
            "target_claim_id": {"type": "string", "pattern": "^vcl_[0-9a-f]{64}$"},
            "affected_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^vcl_[0-9a-f]{64}$"}}
          }
        },
        "before": {"$ref": "#/$defs/standingState"},
        "if_accept": {"$ref": "#/$defs/standingState"},
        "if_reject": {"$ref": "#/$defs/standingState"}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_id", "proposal_root", "source_submission_id", "proposed_claim_id", "assertion", "conditions", "limits", "verification_ids", "verification_set_root", "inbox_entry_root", "protocol_gate", "human_decision_required", "verification_is_acceptance", "standing_delta", "staleness", "next_if_accept_code", "next_if_reject_code"],
      "properties": {
        "proposal_id": {"type": "string", "pattern": "^vpr_[0-9a-f]{16}$"},
        "proposal_root": {"$ref": "#/$defs/root"},
        "source_submission_id": {"type": "string", "pattern": "^vsb_[0-9a-f]{16}$"},
        "proposed_claim_id": {"type": "string", "pattern": "^vcl_[0-9a-f]{64}$"},
        "assertion": {"type": "string", "minLength": 1},
        "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "limits": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "verification_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^vvr_[0-9a-f]{16}$"}},
        "verification_set_root": {"$ref": "#/$defs/root"},
        "inbox_entry_root": {"$ref": "#/$defs/root"},
        "protocol_gate": {"enum": ["satisfied", "blocked"]},
        "human_decision_required": {"const": true},
        "verification_is_acceptance": {"const": false},
        "standing_delta": {"$ref": "#/$defs/standingDelta"},
        "staleness": {"enum": ["current", "stale"]},
        "next_if_accept_code": {"const": "replay_and_recompute_targets"},
        "next_if_reject_code": {"const": "replay_without_standing_change"}
      }
    }
  }
}
