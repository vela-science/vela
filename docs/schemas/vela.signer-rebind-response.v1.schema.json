{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vela.science/schemas/vela.signer-rebind-response.v1.schema.json",
  "title": "Vela protected signer rebind response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_root",
    "actor",
    "public_key",
    "helper_version",
    "helper_sha256",
    "provider",
    "protection_grade",
    "protection_mode",
    "rebound_at",
    "signature"
  ],
  "properties": {
    "schema": { "const": "vela.signer-rebind-response.v1" },
    "request_root": { "$ref": "#/$defs/sha256" },
    "actor": { "type": "string", "minLength": 1 },
    "public_key": { "$ref": "#/$defs/lowerHex32" },
    "helper_version": { "type": "string", "minLength": 1 },
    "helper_sha256": { "$ref": "#/$defs/sha256" },
    "provider": { "type": "string", "minLength": 1 },
    "protection_grade": { "type": "string", "minLength": 1 },
    "protection_mode": { "enum": ["session", "always"] },
    "rebound_at": { "type": "string", "format": "date-time" },
    "signature": { "type": "string", "pattern": "^v1:[0-9a-f]{128}$" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "lowerHex32": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
