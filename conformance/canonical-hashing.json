      "sha256": "016340518d42e38bf144785a7b4da7cc97a1338321b927915b6c2349721e0040"
    },
    {
      "name": "floats render with a decimal point (content-address form)",
      "input": { "ratio": 1.5, "score": 1.0, "tiny": 0.001 },
      "canonical": "{\"ratio\":1.5,\"score\":1.0,\"tiny\":0.001}",
      "sha256": "7339335626f370137d3df5ceefd12adf8475b735af4b573a408a1618c13a9ae8"
