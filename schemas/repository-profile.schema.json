{
  "$id": "https://vela.science/schemas/repository-profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "license": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "content": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "data": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        }
      },
      "required": [
        "content",
        "code",
        "data"
      ],
      "type": "object"
    },
    "maintainers": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "name": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "type": "string"
    },
    "repository_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "schema": {
      "const": "vela.repository-profile.v1",
      "type": "string"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "excludes": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "includes": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "question": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        }
      },
      "required": [
        "question",
        "includes",
        "excludes"
      ],
      "type": "object"
    },
    "summary": {
      "maxLength": 2048,
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "repository_id",
    "name",
    "summary",
    "scope",
    "maintainers",
    "license"
  ],
  "title": "Vela Repository Profile v1",
  "type": "object"
}
