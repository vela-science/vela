{
  "name": "@vela-science/canopus",
  "version": "0.8.0",
  "description": "A bounded, replaceable research harness over released Vela interfaces",
  "type": "module",
  "private": false,
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vela-science/vela.git",
    "directory": "packages/canopus"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22 <23 || >=24 <25"
  },
  "packageManager": "bun@1.3.12",
  "bin": {
    "canopus": "dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/activity",
    "dist/src/artifact",
    "dist/src/budget",
    "dist/src/candidate",
    "dist/src/contracts",
    "dist/src/engines",
    "dist/src/evidence",
    "dist/src/mission",
    "dist/src/product",
    "dist/src/projection",
    "dist/src/util",
    "dist/src/vela",
    "dist/src/verifier",
    "dist/src/workspace",
    "dist/src/cli.js",
    "dist/src/cli.d.ts",
    "dist/src/index.js",
    "dist/src/index.d.ts",
    "dist/src/run.js",
    "dist/src/run.d.ts",
    "schemas",
    "capsules/erdos1056-k15/bin/linux-arm64/10429401-10429600/verifier",
    "capsules/erdos1056-k15/bin/linux-x86_64/10429401-10429600/verifier",
    "capsules/formal-erdos-505-test-dim-one/README.md",
    "capsules/formal-erdos-505-test-dim-one/verifier",
    "missions",
    "profiles",
    "compatibility.json",
    "toolchain.lock.json",
    "runtime",
    "tests/fixtures/run-hostile-native-custody.mjs",
    "tests/fixtures/run-hostile-verifier.mjs",
    "tests/fixtures/hostile-verifier",
    "README.md",
    "THIRD_PARTY.md",
    "docs/MISSIONS.md",
    "docs/RUN_RECORD.md",
    "docs/EVALUATION.md",
    "docs/adr/0010-nonmutating-runs-and-explicit-submission.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "node tooling/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && node --test 'dist/tests/**/*.test.js' 'tests/**/*.test.mjs'",
    "check": "bun run lint && bun run test",
    "prepack": "bun run build",
    "pack:check": "bun pm pack --dry-run",
    "fixture:hostile-custody": "node tests/fixtures/run-hostile-native-custody.mjs",
    "fixture:hostile-verifier": "node tests/fixtures/run-hostile-verifier.mjs",
    "eval:validate": "bun evaluation/commands/validate-plan.mjs",
    "eval:run": "bun evaluation/commands/run-plan.mjs",
    "eval:report": "bun evaluation/commands/report.mjs",
    "eval:conformance": "node --test tests/evaluation-plan.test.mjs tests/evaluation-scientific-task.test.mjs tests/evaluation-erdos-task.test.mjs tests/evaluation-stage-a-wrapper.test.mjs",
    "eval:wrapper:build": "bun evaluation/wrappers/build-stage-a.mjs",
    "eval:stage:a": "bun evaluation/commands/stage-stage-a.mjs",
    "eval:task:prepare:scientific": "bun evaluation/tasks/core-bench-1108125/prepare.mjs",
    "eval:task:verify:scientific": "bun evaluation/tasks/core-bench-1108125/verify.mjs",
    "eval:task:prepare:erdos": "bun evaluation/tasks/erdos-1056-10429401-10429600/prepare.mjs",
    "eval:task:build-verifier:erdos": "bun evaluation/tasks/erdos-1056-10429401-10429600/build-verifier.mjs",
    "trace:export": "bun evaluation/commands/trace-export.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@vela-science/protocol": "workspace:*"
  }
}
